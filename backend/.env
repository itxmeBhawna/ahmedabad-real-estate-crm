# ─────────────────────────────────────────────
# Database configuration
# ─────────────────────────────────────────────

# Set to "sqlite" to use a local SQLite file (zero-config dev/testing)
# Set to "mysql"  to use a MySQL / MariaDB server
DB_ENGINE=sqlite

# MySQL connection (only used when DB_ENGINE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ahmedabad_re_crm

# SQLite file path (only used when DB_ENGINE=sqlite)
SQLITE_PATH=./ahmedabad_re_crm.db

