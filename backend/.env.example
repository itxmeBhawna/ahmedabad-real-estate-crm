# ─────────────────────────────────────────────
# Database configuration
# ─────────────────────────────────────────────

# Set to "sqlite" to use a local SQLite file (zero-config dev/testing)
# Set to "mysql"  to use a MySQL / MariaDB server
DB_ENGINE=sqlite

# MySQL connection (only used when DB_ENGINE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=ahmedabad_re_crm

# SQLite file path (only used when DB_ENGINE=sqlite)
SQLITE_PATH=./ahmedabad_re_crm.db

# ─────────────────────────────────────────────
# JWT / Security  (Phase 2)
# ─────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

